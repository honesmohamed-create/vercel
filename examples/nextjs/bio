              <div className="w-24 h-24 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
                <div className="flex items-center space-x-1">
                  <Dna className="w-8 h-8 text-green-600" />
                  <Microscope className="w-8 h-8 text-blue-600" />
                </div>
              </div>
              <h1 className="text-2xl font-bold text-white mb-2">Biotechnology Program</h1>
              <p className="text-white/90 text-sm font-medium">Fayoum University</p>
              <p className="text-white/70 text-xs mt-1">Learning Management System</p>
            </div>
          </div>

          <div className="p-8">
            <form onSubmit={handleLogin} className="space-y-6">
              {error && (
                <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm flex items-center">
