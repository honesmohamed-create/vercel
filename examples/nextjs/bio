                  >
                    <option value="">Select Semester</option>
                    <option value="Fall 2024">Fall 2024</option>
                    <option value="Spring 2024">Spring 2024</option>
                    <option value="Summer 2024">Summer 2024</option>
                    <option value="Fall 2025">Fall 2025</option>
                    <option value="Spring 2025">Spring 2025</option>
                  </select>
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                    <Atom className="w-4 h-4 mr-2 text-red-500" />
                    Credit Hours
                  </label>
                  <input
                    type="number"
                    value={credit}
                    onChange={(e) => setCredit(e.target.value)}
                    className="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-white/70"
                    placeholder="3"
                    min="1"
                    max="6"
                  />
                </div>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                  <Upload className="w-4 h-4 mr-2 text-green-500" />
                  Course Materials
                </label>
                <div className="flex items-center space-x-4">
                  <input
                    ref={fileInputRef}
                    type="file"
                    onChange={(e) => setFile(e.target.files?.[0] || null)}
                    className="flex-1 px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 bg-white/70"
                    accept=".pdf,.doc,.docx,.ppt,.pptx"
                  />
                  <Microscope className="w-6 h-6 text-gray-400" />
                </div>
                {file && (
                  <p className="mt-2 text-sm text-green-600 flex items-center">
                    <FileText className="w-4 h-4 mr-2" />
                    File selected: {file.name}
                  </p>
                )}
              </div>

              <div className="flex space-x-4">
                <button
                  type="submit"
                  disabled={uploading}
                  className="px-8 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-medium hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all duration-200 disabled:opacity-70 flex items-center"
                >
                  {uploading ? (
                    <>
                      <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                      Processing...
                    </>
                  ) : (
                    <>
                      <Save className="w-4 h-4 mr-2" />
                      {editingCourse ? 'Update Course' : 'Add Course'}
                    </>
                  )}
                </button>

                <button type="button" onClick={resetForm} className="px-8 py-3 bg-gray-100 text-gray-700 rounded-xl font-medium hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-500 transition-colors flex items-center">
                  <X className="w-4 h-4 mr-2" />
                  {editingCourse ? 'Cancel Update' : 'Clear Form'}
                </button>
              </div>
            </form>
          </div>
        </div>

        <div className="bg-white/95 backdrop-blur-sm rounded-3xl shadow-xl border border-white/20 overflow-hidden mt-6">
          <div className="bg-gradient-to-r from-blue-500 to-green-500 p-6">
            <h3 className="text-xl font-bold text-white flex items-center">
              <Dna className="w-6 h-6 mr-3 animate-pulse" />
              Course Database ({courses.length} courses)
            </h3>
          </div>

          <div className="p-6 bg-gradient-to-br from-blue-50/30 to-green-50/30">
            {courses.length === 0 ? (
              <div className="text-center py-12">
                <div className="flex justify-center space-x-4 mb-4">
                  <TestTube className="w-16 h-16 text-gray-300" />
                  <Beaker className="w-16 h-16 text-gray-300" />
                </div>
                <p className="text-gray-500 text-lg">No courses added yet</p>
                <p className="text-gray-400 text-sm">Start by adding your first biotechnology course</p>
              </div>
            ) : (
              <div className="space-y-4">
                {courses.map((c) => (
                  <div key={c.id} className="bg-gradient-to-r from-white/80 to-gray-50/80 backdrop-blur-sm border border-gray-200 rounded-2xl p-4 flex items-center justify-between">
                    <div className="flex-1">
                      <div className="flex items-center mb-2">
                        <div className="w-12 h-12 bg-gradient-to-br from-blue-500 to-green-500 rounded-xl flex items-center justify-center mr-4">
                          <Dna className="w-6 h-6 text-white" />
                        </div>
                        <div>
                          <h4 className="text-lg font-bold text-gray-800">{c.courseName}</h4>
                          <span className="px-3 py-1 bg-gradient-to-r from-blue-100 to-green-100 text-blue-800 text-sm rounded-full font-medium">{c.courseCode}</span>
                        </div>
                      </div>

                      {c.description && <p className="text-gray-600 mb-2 leading-relaxed">{c.description}</p>}

                      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm text-gray-500">
                        <div className="flex items-center"><User className="w-4 h-4 mr-2 text-purple-500" />{c.instructor || 'TBD'}</div>
                        <div className="flex items-center"><Clock className="w-4 h-4 mr-2 text-orange-500" />{c.semester || 'TBD'}</div>
                        <div className="flex items-center"><Atom className="w-4 h-4 mr-2 text-red-500" />{c.credit} Credit Hours</div>
                        <div className="flex items-center"><FileText className="w-4 h-4 mr-2 text-green-500" />{c.filename}</div>
                      </div>
                    </div>

                    <div className="flex space-x-2 ml-4">
                      <button onClick={() => startEdit(c)} className="p-3 text-blue-600 hover:bg-blue-100 rounded-xl transition-colors group" title="Edit Course">
                        <Edit3 className="w-5 h-5 group-hover:scale-110 transition-transform" />
                      </button>
                      <button onClick={() => onDeleteCourse(c.id)} className="p-3 text-red-600 hover:bg-red-100 rounded-xl transition-colors group" title="Delete Course">
                        <Trash2 className="w-5 h-5 group-hover:scale-110 transition-transform" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

// -------------------------
// Main App
// -------------------------
const App = () => {
  const [user, setUser] = useState(null);
  const [courses, setCourses] = useState(mockFirebase.firestore.courses);
  const [currentView, setCurrentView] = useState('login');

  useEffect(() => {
    // nothing extra needed here for this simple demo
  }, []);

  const handleLogin = (user) => {
    setUser(user);
    const isAdmin = user.email === 'admin@fayoum.edu.eg';
    setCurrentView(isAdmin ? 'admin' : 'student');
  };

  const handleLogout = async () => {
    await mockFirebase.auth.signOut();
    setUser(null);
    setCurrentView('login');
  };

  const handleAddOrUpdateCourse = (newCourse) => {
    setCourses((prev) => {
      const exists = prev.find((c) => c.id === newCourse.id);
      if (exists) {
        return prev.map((c) => (c.id === newCourse.id ? newCourse : c));
      }
      return [newCourse, ...prev];
    });
  };

  const handleDeleteCourse = (id) => {
    if (window.confirm('Are you sure you want to delete this course?')) {
      setCourses((prev) => prev.filter((c) => c.id !== id));
    }
  };

  if (!user) {
    return <Login onLogin={handleLogin} />;
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 via-white to-green-50">
      <Navigation currentView={currentView} user={user} onNavigate={setCurrentView} onLogout={handleLogout} />

      <div>
        {currentView === 'admin' && user?.email === 'admin@fayoum.edu.eg' && (
          <AdminPanel courses={courses} onAddOrUpdateCourse={handleAddOrUpdateCourse} onDeleteCourse={handleDeleteCourse} />
        )}
        {currentView === 'student' && <StudentPanel courses={courses} />}
      </div>
    </div>
  );
};

export default App;
